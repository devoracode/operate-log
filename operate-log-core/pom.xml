<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.devoracode</groupId>
        <artifactId>operate-log</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>operate-log-core</artifactId>

    <name>operate-log-core</name>
    <description>
        operate-log 核心：注解、AOP 切面、上下文模型、SpEL 引擎、序列化、脱敏、载荷防护、扩展点接口。
    </description>

    <!--
        ============================ 依赖边界（依赖污染防线）============================

        core 是 library，不是应用：它可以在自身编译期依赖 Spring 5.3.31
        （与 Boot 2.7.18 运行时基线一致），但绝不允许通过 Maven dependency graph
        把 Spring 5 强加给消费者。

        风险场景（本 POM 修改前的真实问题）：
          消费者 → operate-log-spring-boot-starter (深度 1)
                 → operate-log-core               (深度 2)
                 → spring-core:5.3.32             (深度 3, compile 传递，修复前)
        与
          消费者 → spring-boot-starter-web → spring-boot-starter → spring-core:6.1.16 (深度 3)
        两条路径同深度时，Maven「同深度先声明优先」调解；消费者若未 import Boot BOM
        （非 spring-boot-starter-parent 的自建 parent / 裸 POM 工程），
        Boot 3 应用可能被调解到 core 的 Spring 5.x —— 启动即 NoSuchMethodError。
        slf4j 更隐蔽：1.7.36 优先时 logback 1.5（仅注册 SLF4JServiceProvider）
        无法被 slf4j 1.7 发现 → 全应用日志静默降为 NOP。

        分类原则（按「宿主是否必然提供」+「跨代二进制兼容性」）：
          · 宿主必然提供、且跨代不兼容  → optional（Spring 5 件套、slf4j-api）
          · 宿主不必然提供、跨代兼容    → compile 保留传递（jackson-databind、
                                         aspectjweaver、commons-lang3）
        后三者若也改 optional，将强制宿主自行补 spring-boot-starter-json / -aop /
        commons-lang3，破坏「只加一个 Starter 依赖即可用」的既有用法（README 快速开始），
        故保留 compile。三者的版本 = Boot 2.7.18 所管理的版本（见根 POM 注释）：
        作为消费者可见的下界，它既不能高于宿主基线（否则与宿主自身的 jackson-core /
        annotations 混版），也不能低于 Boot 3 基线可用范围（Jackson 2.x 线内二进制兼容、
        AspectJ 1.9.x 支持 JDK 8-21、commons-lang3 3.x 线内兼容，BOM 上调即可）。
    -->
    <dependencies>
        <!--
            本模块不含单元测试：断言全部落在 operate-log-test-boot2 / operate-log-test-boot3
            两个真实容器集成测试模块里完成（见 README「构建」中的测试分层）。
        -->

        <!--
            Spring / SLF4J：宿主 Spring Boot 必然提供（Boot 2 → Spring 5.x，Boot 3 → Spring 6.x）。
            optional 使其只参与 core 自身编译，不进入消费者依赖图，版本由宿主 BOM 决定。
            core 源码只使用 Spring 5.3 与 6.x 中签名完全一致的公共 API
            （AopUtils / AnnotationUtils / ClassUtils / DefaultParameterNameDiscoverer /
            SpelExpressionParser / StandardEvaluationContext / RequestAttributes 等），
            以及 slf4j 1.7 与 2.0 一致的 LoggerFactory / Logger / MDC API，跨代二进制兼容。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring.framework.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
            <version>${spring.framework.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.framework.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-expression</artifactId>
            <version>${spring.framework.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 以下三项是 core 的硬运行时依赖，且宿主不必然提供：保留 compile 传递（见上方分类原则） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>8</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
