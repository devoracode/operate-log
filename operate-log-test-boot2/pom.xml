<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.devoracode</groupId>
        <artifactId>operate-log</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>operate-log-test-boot2</artifactId>

    <name>operate-log-test-boot2</name>
    <description>Boot 2.x 冒烟示例（javax 栈），不参与发布与二进制兼容检查。</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <japicmp.skip>true</japicmp.skip>
    </properties>

    <dependencies>
        <!--
            本工程未 import 任何 Boot BOM，Spring / Jackson / logback / SLF4J 版本全部由
            下方 spring-boot-starter-web:2.7.18 的传递依赖决定：core 已将 Spring 与 SLF4J
            声明为 optional（不参与调解），其余三项传递下界与 Boot 2.7.18 基线一致，
            因此不会出现宿主与库之间的混版。
            与 Boot 3 工程对照：同一 Starter 产物在 Boot 2 解析到 Spring 5.x、在 Boot 3 解析到 Spring 6.x，
            由 CI 的 dependency-hygiene 门禁锁定。
        -->
        <dependency>
            <groupId>io.github.devoracode</groupId>
            <artifactId>operate-log-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring.boot2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring.boot2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot2.version}</version>
                <configuration>
                    <mainClass>io.github.devoracode.operatelog.test.boot2.OperateLogBoot2TestApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>8</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
