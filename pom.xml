<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.devoracode</groupId>
    <artifactId>operate-log</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>operate-log</name>
    <description>Operation log starter for Spring Boot 2.x and 3.x</description>
    <url>https://github.com/devoracode/operate-log</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>operate-log-core</module>
        <module>operate-log-spring-boot-starter</module>
        <module>operate-log-test-boot2</module>
    </modules>

    <!--
        test-boot3 依赖 Boot 3（Java 17 字节码），必须 JDK 17+ 才能编译。
        放入按 JDK 版本自动激活的 profile：JDK 8 构建环境自动跳过，
        JDK 17+ 构建环境自动包含，保证「JDK 8 可全量构建」与「Boot 3 可验证」兼得。
    -->
    <profiles>
        <profile>
            <id>boot3-test</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <modules>
                <module>operate-log-test-boot3</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>

        <spring.boot2.version>2.7.18</spring.boot2.version>
        <spring.boot3.version>3.3.13</spring.boot3.version>
        <spring.framework.version>5.3.32</spring.framework.version>
        <jackson.version>2.15.4</jackson.version>
        <aspectj.version>1.9.7</aspectj.version>
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <slf4j.version>1.7.36</slf4j.version>
        <lombok.version>1.18.30</lombok.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>${maven.compiler.parameters}</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
