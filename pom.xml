<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.devoracode</groupId>
    <artifactId>operate-log</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>operate-log</name>
    <description>Operation log starter for Spring Boot 2.x and 3.x</description>
    <url>https://github.com/devoracode/operate-log</url>

    <modules>
        <module>operate-log-core</module>
        <module>operate-log-spring-boot-starter</module>
        <module>operate-log-test-boot2</module>
    </modules>

    <properties>
        <!-- 全仓库唯一版本源：子模块的 <parent><version> 写 ${revision}，发版只改这一处。
             安装/部署的 pom 由 flatten-maven-plugin 展开成具体版本。 -->
        <revision>1.0.0-SNAPSHOT</revision>

        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring.boot2.version>2.7.18</spring.boot2.version>
        <spring.boot3.version>3.3.13</spring.boot3.version>
        <spring.framework.version>5.3.31</spring.framework.version>
        <jackson.version>2.13.5</jackson.version>
        <aspectj.version>1.9.22</aspectj.version>
        <commons-lang3.version>3.12.0</commons-lang3.version>
        <slf4j.version>1.7.36</slf4j.version>
        <lombok.version>1.18.30</lombok.version>
        <junit.version>5.8.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Mockito inline mock maker 依赖 Byte Buddy self-attach；JDK 17+ 默认禁止
                         自附加，不加此项会以「Could not initialize plugin: MockMaker」失败。 -->
                    <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- 只展开 ${revision}，licenses / developers / scm 等发布元数据原样保留 -->
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        boot3-test：JDK 17+ 自动激活，把 test-boot3 纳入构建。
        release：Central 发布；本地干跑用 -Prelease -DskipTests -Dgpg.skip=true verify。
    -->
    <profiles>
        <profile>
            <id>boot3-test</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <modules>
                <module>operate-log-test-boot3</module>
            </modules>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <encoding>${project.build.sourceEncoding}</encoding>
                            <charset>${project.build.sourceEncoding}</charset>
                            <docencoding>UTF-8</docencoding>
                            <additionalJOption>-J-Duser.language=en</additionalJOption>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>devoracode</id>
            <name>Wenjie Liu</name>
            <email>wenger.liu2020@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/devoracode/operate-log</url>
        <connection>scm:git:https://github.com/devoracode/operate-log.git</connection>
        <developerConnection>scm:git:ssh://github.com/devoracode/operate-log.git</developerConnection>
    </scm>
</project>
